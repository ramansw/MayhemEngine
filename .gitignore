# ── Compiled DLLs (keep the ones checked in under Unity/Runtime/Plugins) ─────
# The DLLs under Unity/Runtime/Plugins/x86_64/ ARE intentionally committed
# so users can install via UPM git URL without needing to build from source.
# Only exclude DLLs that land in build output folders.
build/**/*.dll
**/build/**/*.dll
